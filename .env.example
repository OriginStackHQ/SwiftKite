# ============================================================================
# SwiftKite - consolidated environment for `docker compose`.
#
#   cp .env.example .env    then fill in the blank secrets below.
#
# `docker compose` reads this file automatically to resolve every ${VAR} used in
# docker-compose.yml. Nothing here has a fallback default: a missing or empty
# value fails loudly instead of silently picking a placeholder.
#
# Hostnames in this file are the ones seen *inside* the compose network
# (`postgres`, `rabbitmq`). For running the backend/frontend directly on the host
# (e.g. an IDE debug session) use backend/.env and frontend/.env instead, where
# the same services are reached through 127.0.0.1.
# ============================================================================

# ---------------------------------------------------------------- postgres
# Values for the `postgres` service.
POSTGRES_DB=swiftkite
POSTGRES_USER=swiftkite
POSTGRES_PASSWORD=swiftkite
POSTGRES_PORT=5432

# ---------------------------------------------------------------- rabbitmq
# Shared by the `rabbitmq` service and the backend's AMQP client.
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
# AMQP port. Used by the backend (host `rabbitmq`) and published to the host.
RABBITMQ_PORT=5672
# Management UI (http://localhost:15672), published to the host.
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------- published ports
# Host ports for the application containers.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---------------------------------------------------------------- backend: database
# Must point at the `postgres` service and match the POSTGRES_* values above.
DATABASE_URL=jdbc:postgresql://postgres:5432/swiftkite
DATABASE_USERNAME=swiftkite
DATABASE_PASSWORD=swiftkite

# ---------------------------------------------------------------- backend: auth / JWT
# Base64URL, 48 random bytes. Generate with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---------------------------------------------------------------- backend: Google OAuth
# Authorized redirect URI: {api-base-url}/login/oauth2/code/google
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# ---------------------------------------------------------------- backend: web
# Browser origin of the frontend (CORS allow-list + OAuth redirect target).
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_MAX_AGE=2592000
SPRINGDOC_ENABLED=true
RESET_TOKEN_EXPIRY_MINUTES=30

# ---------------------------------------------------------------- backend: RabbitMQ
# `rabbitmq` is the compose service name; credentials come from RABBITMQ_* above.
RABBITMQ_HOST=rabbitmq

# ---------------------------------------------------------------- backend: outbox
OUTBOX_RELAY_DELAY_MS=1000
OUTBOX_INITIAL_DELAY_MS=2000
OUTBOX_BATCH_SIZE=20

# ---------------------------------------------------------------- backend: workers
WORKER_CONCURRENCY=5
WORKER_PREFETCH=1

# ---------------------------------------------------------------- backend: reconciler
RECONCILER_DELAY_MS=30000
RECONCILER_INITIAL_DELAY_MS=10000
RECONCILER_STUCK_AFTER_MINUTES=5

# ---------------------------------------------------------------- backend: scheduler
SCHEDULER_POOL_SIZE=2

# ---------------------------------------------------------------- backend: mail (Resend)
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
MAIL_SYSTEM_FROM_NAME=SwiftKite
MAIL_SYSTEM_FROM_EMAIL=no-reply@example.com

# ---------------------------------------------------------------- backend: webhook (Resend)
# Leave empty to reject all webhook calls until configured.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------- frontend
# Inlined into the client bundle at build time; must be reachable from the
# browser, i.e. the backend's published host port.
NEXT_PUBLIC_API_URL=http://localhost:8080
