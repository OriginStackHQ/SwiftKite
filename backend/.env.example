# Copy to .env (NEVER commit .env) or export these variables directly.
# Local dev defaults live in application.yaml; only secrets are required here.

# 256-bit+ random value, base64url-encoded. Generate with:
#   openssl rand -base64url 48
JWT_SECRET_KEY=

# Database (override only if different from localhost defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/swiftkite
DATABASE_USERNAME=swiftkite
DATABASE_PASSWORD=swiftkite

# Frontend origin (must match the dashboard URL for CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {api-base-url}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set true in production (cookies require Secure + HTTPS)
COOKIE_SECURE=false
