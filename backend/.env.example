# Copy to .env (NEVER commit .env) or export these variables directly.
# Spring Boot loads backend/.env automatically via spring.config.import (see application.yaml).

# Base64URL, 48 random bytes. Generate with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_SECRET_KEY=

# Database: local PostgreSQL on 5432
DATABASE_URL=jdbc:postgresql://localhost:5432/swiftkite
DATABASE_USERNAME=swiftkite
DATABASE_PASSWORD=swiftkite

# Frontend origin (must match the dashboard URL for CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {api-base-url}/login/oauth2/code/google
# Dummy values are enough to boot; replace them to test the Google flow.
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Cookies
COOKIE_SECURE=false
COOKIE_MAX_AGE=2592000

# JWT lifetimes (ms)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Password reset link lifetime (minutes)
RESET_TOKEN_EXPIRY_MINUTES=30

# Swagger UI / OpenAPI (set false outside development)
SPRINGDOC_ENABLED=true

# Mail. One sending address for every newsletter; the publication name is the
# From display name. Account mail (password reset) has its own sender.
# MAIL_PROVIDER=fake logs the email instead of calling Resend, for local work.
MAIL_PROVIDER=resend
MAIL_FROM_EMAIL=no-reply@intentctrl.com
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
MAIL_SYSTEM_FROM_NAME=SwiftKite
MAIL_SYSTEM_FROM_EMAIL=no-reply@intentctrl.com

# HMAC key for confirmation and unsubscribe tokens (required).
TOKEN_SIGNING_KEY=replace-with-a-random-64-char-hex-string
