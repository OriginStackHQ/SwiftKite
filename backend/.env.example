# Copy to backend/.env (NEVER commit .env). application.yaml imports backend/.env
# automatically when started from the repository root; exported environment
# variables still take precedence. Every variable referenced by application.yaml
# must be set.

# ---------------------------------------------------------------- database
DATABASE_URL=jdbc:postgresql://localhost:5432/swiftkite
DATABASE_USERNAME=swiftkite
DATABASE_PASSWORD=swiftkite

# ---------------------------------------------------------------- auth / JWT
# Base64URL, 48 random bytes. Generate with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---------------------------------------------------------------- Google OAuth
# Authorized redirect URI: {api-base-url}/login/oauth2/code/google
# Dummy values are enough to boot; replace them to test the Google flow.
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# ---------------------------------------------------------------- web
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_MAX_AGE=2592000
SPRINGDOC_ENABLED=true
RESET_TOKEN_EXPIRY_MINUTES=30

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq

# ---------------------------------------------------------------- outbox
OUTBOX_RELAY_DELAY_MS=1000
OUTBOX_INITIAL_DELAY_MS=2000
OUTBOX_BATCH_SIZE=20

# ---------------------------------------------------------------- workers
WORKER_CONCURRENCY=5
WORKER_PREFETCH=1

# ---------------------------------------------------------------- reconciler
RECONCILER_DELAY_MS=30000
RECONCILER_INITIAL_DELAY_MS=10000
RECONCILER_STUCK_AFTER_MINUTES=5

# ---------------------------------------------------------------- scheduler
SCHEDULER_POOL_SIZE=2

# ---------------------------------------------------------------- mail (Resend)
# Account mail uses these; campaign mail uses the campaign's sender fields.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
MAIL_SYSTEM_FROM_NAME=SwiftKite
MAIL_SYSTEM_FROM_EMAIL=no-reply@example.com

# ---------------------------------------------------------------- webhook (Resend)
# Leave empty to reject all webhook calls until configured.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
